; Engine configuration file.
; Vegan Guys - Fall Guys style multiplayer party game
; Godot 4.6+ compatible

config_version=5

[application]

config/name="Vegan Guys"
config/description="Multiplayer party game - last vegan standing wins!"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/textures/icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

